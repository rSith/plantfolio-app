# Copy this file to ml-service/.env (git-ignored) and fill in the key. Never commit .env.
# Free key: create an account at https://my.plantnet.org, then "My account" → API key (500 identifications a day).
PLANTNET_API_KEY=
# Seconds to wait for Pl@ntNet; keep it below ml_timeout_seconds in config/config.php (10)
PLANTNET_TIMEOUT=8
# Where Health Check answers come from: plantnet (now) or model (our own models/disease.keras, if trained later)
DISEASE_PROVIDER=plantnet
